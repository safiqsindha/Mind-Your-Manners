# Copy to .env and fill in only the keys you actually need for the models
# you're running. Never commit a real .env file.

# Google Gemini (direct API) -- Gemini Flash-tier model
GOOGLE_API_KEY=

# DeepSeek (direct API, OpenAI-compatible)
DEEPSEEK_API_KEY=

# Alibaba DashScope / Qwen (direct API, OpenAI-compatible)
DASHSCOPE_API_KEY=

# OpenRouter -- used for the Llama/Gemma-tier open-weight model, with the
# backend provider pinned explicitly in harness/config.py (ModelConfig.provider_pin)
OPENROUTER_API_KEY=

# Anthropic -- optional frontier spot-check only
ANTHROPIC_API_KEY=

# Hugging Face -- required to download GPQA Diamond (gated dataset); you must
# also accept its terms on huggingface.co with the account behind this token
HF_TOKEN=
