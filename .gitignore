__pycache__/
*.pyc
.pytest_cache/
.env
*.egg-info/

# Raw/analysis output from real or dry-run harness executions -- these are
# generated data, not source. Keep the directories tracked via .gitkeep but
# never commit their contents.
results/raw/*.jsonl
results/analysis/*.json
# The incremental per-record log _append_record writes as a run progresses.
# Added when crash-durability was, but never added here, so a live run left
# an untracked file that changes every few seconds and must not be committed.
results/analysis/*.jsonl
results/spend_log.jsonl
results/scratch/
!results/raw/.gitkeep
!results/analysis/.gitkeep

# Large cloned/downloaded benchmark data
data/spreadsheetbench/
data/AgenticPay/
*.xlsx
!tests/**/*.xlsx
results/locks/

# Benchmark dataset clones. A multi-hundred-megabyte checkout of
# SpreadsheetBench (spreadsheet binaries), fetched on demand by
# dataset.ensure_repo and reused across runs. Generated input, never source --
# and large enough that committing it once would be hard to undo.
.cache/
data/spreadsheetbench/
